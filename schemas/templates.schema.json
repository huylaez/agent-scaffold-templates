{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-scaffold.dev/schemas/templates.schema.json",
  "title": "Agent Scaffold Template Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "manifest"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "manifest": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
